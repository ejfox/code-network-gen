{
  "name": "code-network-gen",
  "version": "0.1.0",
  "description": "Explore your JavaScript ecosystem with this network-based code structure analysis tool",
  "main": "index.js",
  "bin": {
    "code-network-gen": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node test/run.js",
    "meta": "node index.js --path . -o output/meta_analysis && echo 'Meta-analysis results saved to output/meta_analysis_nodes.csv and output/meta_analysis_edges.csv'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"*.js\" \"lib/**/*.js\" \"test/**/*.js\" package.json .prettierrc",
    "format:check": "prettier --check \"*.js\" \"lib/**/*.js\" \"test/**/*.js\" package.json .prettierrc",
    "analyze": "node index.js --path . -o output/analysis",
    "dev": "node index.js"
  },
  "keywords": [
    "javascript",
    "vue",
    "code-analysis",
    "network-analysis",
    "static-analysis",
    "dependency-graph",
    "function-calls",
    "ast",
    "code-visualization",
    "software-architecture",
    "csv-export",
    "gexf-export",
    "graphml-export",
    "dot-export",
    "mermaid-export",
    "method-mapping",
    "yed",
    "cytoscape",
    "graphviz",
    "mermaid",
    "flowchart",
    "github-markdown",
    "documentation"
  ],
  "author": "ejfox",
  "license": "ISC",
  "homepage": "https://github.com/ejfox/code-network-gen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejfox/code-network-gen.git"
  },
  "bugs": {
    "url": "https://github.com/ejfox/code-network-gen/issues"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.52.0",
    "@vue/compiler-sfc": "^3.5.26",
    "commander": "^14.0.2",
    "json2csv": "^6.0.0-alpha.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
